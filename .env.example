# ───────────────────────── Shared ─────────────────────────
DATABASE_URL=postgres://tribes:tribes@localhost:5432/tribes
REDIS_URL=redis://localhost:6379

# ───────────────────────── Auth (Privy) ─────────────────────────
# https://dashboard.privy.io — create an app, enable Twitter/X login
PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=

# ───────────────────────── SocialData (X scraping, read-only) ──────────
# https://socialdata.tools
SOCIALDATA_API_KEY=
# Global daily item cap across all sync jobs (1 item ≈ $0.0002)
SOCIALDATA_DAILY_CAP=50000

# ───────────────────────── X API (write-back: posting to users' X) ─────
# https://developer.x.com — OAuth 2.0 app with tweet.read tweet.write
# users.read offline.access scopes. Pay-per-use billing.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3001/v1/x/callback
# Secret for AES-256-GCM encryption of stored OAuth tokens (any string of
# 16+ chars; a 32-byte key is derived from it): openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ───────────────────────── Solana / Launchpad ─────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Platform fee wallet — receives creator-fee split + in-app trade fees
PLATFORM_FEE_WALLET=
# In-app trade fee in basis points (100 = 1%)
PLATFORM_TRADE_FEE_BPS=100
# Creator fee split: platform share in basis points (5000 = 50/50)
PLATFORM_CREATOR_FEE_SHARE_BPS=5000
# PumpPortal (https://pumpportal.fun) — only needed if using their Lightning API
PUMPPORTAL_API_KEY=

# ───────────────────────── API service ─────────────────────────
PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# ───────────────────────── Web app ─────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
